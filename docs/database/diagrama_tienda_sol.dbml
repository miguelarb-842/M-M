// Modulo Usuario
Table Rol {
  id_rol integer [pk, increment, not null]
  nombre text [not null]
  descripcion text 
  creacion text [not null, note: "Fecha de creacion"]
  actulizacion text [not null, note: "Ultima actulizacion del rol"]
}

Table Usuario {
  id_usuario integer [pk, increment,not null]
  nombre text [not null]
  correo text [not null, unique]
  clave text [not null]
  actualizacion text [not null, note: "Se tiene que pedir la fecha"]
}

Table Usuario_rol {
  id_usr integer [not null, ref: > Usuario.id_usuario]
  id_rol integer [not null, ref: > Rol.id_rol]
  estado integer [not null, default: 1, note: '1 = activo, 0 = inactivo']

  indexes {
    (id_usr, id_rol) [pk]
  }
}

Table Historial_clave {
  id_his_cla integer [pk, increment, not null]
  usario integer [not null, ref: > Usuario.id_usuario]
  contraseña_pasada text [not null]
  fecha_creacion text [not null, note: "Creacion de contraseña"]
  
}

// Modulo de productos 
Table Tipo_Telefono {
  id_ti_tele integer [pk, increment, not null]
  nombre text [not null]
  descipcion text
}

Table Telefono {
  id_tele integer [pk, increment, not null]
  numero_telefonico text [not null,unique]
  tipo_telefono text [not null,ref: > Tipo_Telefono.id_ti_tele]
  codigo_telefonico integer [defaul: "505"]  
  creacion text [not null, note: "Sacar fecha"]

}

Table Provedores {
  id_prov integer [pk, increment,not null]
  nombre_empresa text [not null]
  nombre_contacto text [not null]
  cargo text 

  telefono text [not null]
  descripcion text
  gmail text 

}

